# Секреты — никогда не коммитить
.streamlit/secrets.toml
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/

# macOS
.DS_Store

# Креды MCP к Lakebase — пароли в открытом виде, в git не место
.mcp.json

# Локальные настройки Claude Code
# .claude: локальные настройки не коммитим, а общие хуки и settings.json — да
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/launch.json
