{
  "name": "Kabinet - TikTok Shop Loader",
  "description": "TikTok Shop: заказы, товары, финансы → dnipro_m.tiktok.raw_* и реплики kabinet_data.raw_tiktok_*. Ежедневно 06:30 Kyiv (после полуночи по Мадриду, до сводки 08:00). Только чтение у TikTok.",
  "run_as": {
    "service_principal_name": "<APPLICATION_ID kabinet-jobs-sp>"
  },
  "schedule": {
    "quartz_cron_expression": "0 30 6 * * ?",
    "timezone_id": "Europe/Kyiv",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 1800,
  "queue": {
    "enabled": true
  },
  "email_notifications": {},
  "environments": [
    {
      "environment_key": "default",
      "spec": {
        "client": "2"
      }
    }
  ],
  "tasks": [
    {
      "task_key": "load",
      "environment_key": "default",
      "notebook_task": {
        "notebook_path": "/Users/v.tereshyn@dniprom.com/Kabinet - TikTok Shop/Kabinet - TikTok Shop Loader",
        "source": "WORKSPACE",
        "base_parameters": {
          "dry_run": "0",
          "full": "0"
        }
      },
      "timeout_seconds": 1800,
      "max_retries": 1,
      "min_retry_interval_millis": 600000,
      "retry_on_timeout": false
    }
  ]
}
