{
  "name": "Kabinet - После Ledger Summary (запасной)",
  "description": "Страховка вечерней цепочки: в 18:30 проверяет, была ли сегодня вечерняя запись Ledger Summary и отработала ли цепочка «Kabinet - После Ledger Summary». Нет — запускает Stock Loader и Coverage на том, что есть, и шлёт тревогу в бот (инцидент ledger_evening).",
  "max_concurrent_runs": 1,
  "schedule": {"quartz_cron_expression": "0 30 18 * * ?", "timezone_id": "Europe/Kyiv", "pause_status": "UNPAUSED"},
  "environments": [{"environment_key": "default",
                    "spec": {"client": "2", "dependencies": ["psycopg2-binary", "databricks-sdk>=0.118.0", "requests"]}}],
  "tasks": [
    {"task_key": "check", "environment_key": "default", "timeout_seconds": 1800,
     "notebook_task": {"notebook_path": "/Users/v.tereshyn@dniprom.com/Kabinet - После Ledger Summary (запасной)",
                       "source": "WORKSPACE"}},
    {"task_key": "need_run", "depends_on": [{"task_key": "check"}],
     "condition_task": {"op": "EQUAL_TO", "left": "{{tasks.check.values.need_run}}", "right": "true"}},
    {"task_key": "stock_loader", "depends_on": [{"task_key": "need_run", "outcome": "true"}],
     "run_job_task": {"job_id": 201160589560980}, "timeout_seconds": 3600},
    {"task_key": "coverage_projection", "depends_on": [{"task_key": "stock_loader"}], "run_if": "ALL_SUCCESS",
     "run_job_task": {"job_id": 847957236064692}, "timeout_seconds": 3600}
  ]
}
