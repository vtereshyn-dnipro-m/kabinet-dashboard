+# ─── Время Мадрида (с 14.10.2026) ───
+# Mirakl отдаёт created_date в UTC («…Z»), и день заказа по первым десяти знакам строки был днём UTC: заказ в 00:30
+# по Мадриду ложился во вчерашний день. Теперь в рабочих колонках — часы Мадрида через часовой пояс (летом +2,
+# зимой +1, по дате каждой строки), исходный момент — в created_at_utc, день по UTC — в order_date_utc.
+def _mad_str(iso):
+    """ISO от Mirakl → «ГГГГ-ММ-ДД ЧЧ:ММ:СС» по Мадриду (без пояса); пусто → None."""
+    if not iso:
+        return None
+    d = datetime.datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
+    d = d if d.tzinfo else d.replace(tzinfo=datetime.timezone.utc)
+    return d.astimezone(ZoneInfo("Europe/Madrid")).strftime("%Y-%m-%d %H:%M:%S")
+
