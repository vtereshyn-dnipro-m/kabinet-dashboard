 # ═════════════════════════════════════════════════════════════════
 
 import psycopg2.extras
+import datetime as _dtm
+from zoneinfo import ZoneInfo as _ZI
 
+# Время Мадрида (с 14.10.2026): в рабочую колонку — часы Мадрида без пояса (сессия в UTC, Postgres запишет их как
+# время UTC — то же правило, что в UC), в *_utc — исходный момент. Строку «…Z» в рабочую колонку передавать нельзя:
+# она ляжет настоящим UTC, и день съедет.
+def _utc_dt(s):
+    if not s:
+        return None
+    d = _dtm.datetime.fromisoformat(str(s).replace("Z", "+00:00"))
+    return (d if d.tzinfo else d.replace(tzinfo=_dtm.timezone.utc)).astimezone(_dtm.timezone.utc)
+
+def _mad_dt(s):
+    u = _utc_dt(s)
+    return u.astimezone(_ZI("Europe/Madrid")).replace(tzinfo=None) if u else None
+
