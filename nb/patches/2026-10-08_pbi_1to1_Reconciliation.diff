+        data = [(str(r["mon"]), r["marketplace"], r["country"], [r[f"m{i}"] for i in range(len(PBI_METRICS))])
+                for r in spark.sql(f"""
+                    SELECT date_format(date, 'yyyy-MM') AS mon, marketplace, country, {sel}
+                    FROM {VIEW} WHERE date >= '{_pbi_from}' AND date < current_date()
+                    GROUP BY 1, 2, 3""").collect()]
+    else:
+        sel = ", ".join(f"sum({e})::float" for _, _, e, _ in PBI_METRICS)
+        data = [(r[0], r[1], r[2], list(r[3:])) for r in fetch(f"""
+                    SELECT to_char(date, 'YYYY-MM'), pbi_marketplace, pbi_country, {sel}
+                    FROM {PBI_TABLE} WHERE date >= %s AND date < current_date
+                    GROUP BY 1, 2, 3""", (_pbi_from,))]
