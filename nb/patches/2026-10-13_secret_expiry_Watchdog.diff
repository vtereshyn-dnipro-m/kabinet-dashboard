+# ─── СРОК КЛЮЧА SP-API ──────────────────────────────────────────────
+# Client secret приложения SP-API Amazon живёт около 180 дней. 13.10.2026 старый истёк молча: загрузчики
+# упали на 403 «The LWA secret token you provided has expired», и узнали об этом по падениям. Здесь — напоминание
+# ЗАРАНЕЕ: срок считается от даты обновления секрета `amazon-sp-api/lwa-client-secret` в Databricks (её отдаёт
+# список секретов скоупа, само значение не читается), + `spapi_secret_lifetime_days` (180). За
+# `spapi_secret_warn_days` (14) дней до конца — инцидент secret_expiry (high, за 3 дня и после — critical), и он
+# висит в дневной сводке, пока ключ не заменят. Замена меняет дату обновления — тревога закрывается сама.
+# Ключ лежит в трёх местах (Databricks, Streamlit Secrets Listing Suite и Кабинета) — менять во всех трёх.
+try:
+    pg_cur.execute("""SELECT key, value FROM kabinet_data.reorder_params
+                      WHERE key IN ('spapi_secret_lifetime_days', 'spapi_secret_warn_days')""")
+    _se_p = {k: float(v) for k, v in pg_cur.fetchall()}
+    _se_life = int(_se_p.get("spapi_secret_lifetime_days", 180))
+    _se_warn = int(_se_p.get("spapi_secret_warn_days", 14))
+    _se_meta = {s.key: s.last_updated_timestamp for s in w.secrets.list_secrets("amazon-sp-api")}
+    if "lwa-client-secret" not in _se_meta:
+        raise RuntimeError("в скоупе amazon-sp-api нет ключа lwa-client-secret")
+    _se_upd = datetime.fromtimestamp(_se_meta["lwa-client-secret"] / 1000, tz=timezone.utc).date()
+    _se_exp = _se_upd + timedelta(days=_se_life)
+    _se_left = (_se_exp - datetime.now(timezone.utc).date()).days
+    _se_tok = "[SECRET:amazon-sp-api/lwa-client-secret]"
+    _se_want = None
+    if _se_left <= _se_warn:
+        _se_sev = "critical" if _se_left <= 3 else "high"
+        _se_when = (f"истёк {_se_exp:%d.%m.%Y}" if _se_left < 0 else
+                    f"истекает {_se_exp:%d.%m.%Y} — осталось {_se_left} дн.")
+        _se_want = (f"{_se_tok} Client secret SP-API {_se_when} (обновлён {_se_upd:%d.%m.%Y}, срок ~{_se_life} дней). "
+                    f"Выпустить новый в Seller Central → Developer Central и заменить в трёх местах: Databricks "
+                    f"amazon-sp-api/lwa-client-secret, Streamlit Secrets Listing Suite и Streamlit Secrets Кабинета "
+                    f"(SP_API_CLIENT_SECRET). После истечения встанут все загрузчики Amazon.")
+    pg_cur.execute("""SELECT id, message, severity FROM kabinet_data.incidents
+                      WHERE incident_type = 'secret_expiry' AND resolved_at IS NULL AND message LIKE %s""",
+                   (_se_tok + "%",))
+    _se_open = pg_cur.fetchall()
+    if REPORT_ONLY:
+        print(f"\n🔐 Срок ключа SP-API (REPORT_ONLY): до {_se_exp:%d.%m.%Y}, осталось {_se_left} дн. — не пишем")
+    elif _se_want:
+        if _se_open:
+            pg_cur.execute("UPDATE kabinet_data.incidents SET message = %s, severity = %s WHERE id = %s",
+                           (_se_want, _se_sev, _se_open[0][0]))
+        else:
+            pg_cur.execute("""INSERT INTO kabinet_data.incidents (incident_type, severity, source, sku, warehouse_name, message, status, created_at)
+                              VALUES ('secret_expiry', %s, 'watchdog', NULL, NULL, %s, 'open', now())""", (_se_sev, _se_want))
+    elif _se_open:
+        pg_cur.execute("""UPDATE kabinet_data.incidents SET status = 'resolved', resolved_at = now(),
+                          resolved_by = 'watchdog-autoclose: ключ заменён' WHERE id = %s""", (_se_open[0][0],))
+    pg_conn.commit()
+    print(f"\n🔐 Срок ключа SP-API: обновлён {_se_upd:%d.%m.%Y}, истекает ~{_se_exp:%d.%m.%Y}, осталось {_se_left} дн."
+          + (" — тревога" if _se_want else ""))
+except Exception as e:
+    pg_conn.rollback()
+    print(f"\n⚠️ Secret expiry check failed: {type(e).__name__}: {e}")
+    _soft_errors.append(("срок ключа SP-API", f"{type(e).__name__}: {str(e)[:150]}"))
 
