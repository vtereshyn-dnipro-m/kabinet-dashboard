+from zoneinfo import ZoneInfo as _ZI
+# В рабочую колонку — часы Мадрида без пояса: сессия в UTC (SET TIME ZONE ниже), и Postgres запишет их как
+# время UTC — то же правило, что в UC. Строку «…Z» туда передавать нельзя: она ляжет настоящим UTC, и день съедет.
+def _utc_dt(s):
+    if not s:
+        return None
+    d = dt.datetime.fromisoformat(str(s).replace("Z", "+00:00"))
+    return (d if d.tzinfo else d.replace(tzinfo=dt.timezone.utc)).astimezone(dt.timezone.utc)
+def _mad_dt(s):
+    u = _utc_dt(s)
+    return u.astimezone(_ZI("Europe/Madrid")).replace(tzinfo=None) if u else None
